[app]
PAGE_SIZE = 10
RuntimeRootPath = runtime/
LogPath = /var/log/casaos/
LogSaveName = log
LogFileExt = log
DateStrFormat = 20060102
DateTimeFormat = 2006-01-02 15:04:05
TimeFormat = 15:04:05
DateFormat = 2006-01-02
DBPath     = /var/lib/casaos
ShellPath  = /usr/share/casaos/shell
UserDataPath = /var/lib/casaos/conf

[server]
RunMode = release
ServerApi =
Handshake =
Token = 
USBAutoMount =
; Who owns /etc/samba/smb.conf: "managed" (default, CasaOS writes it) or
; "external" (the host's configuration management owns it and includes
; /etc/samba/smb.casa.conf; CasaOS then manages only that fragment).
SambaMainConfig = managed

[system]
