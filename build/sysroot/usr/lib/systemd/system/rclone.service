[Unit]
Description=rclone

[Service]
RuntimeDirectory=rclone
RuntimeDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/bin/rm -f /run/rclone/rclone.sock
ExecStart=/usr/bin/rclone rcd --rc-addr unix:///run/rclone/rclone.sock --rc-no-auth
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
