[Unit]
Description=ReCasaOS isolated public-file portal
ConditionPathIsDirectory=/srv/recasaos-public
ConditionPathIsSymbolicLink=!/srv/recasaos-public
ConditionFileNotEmpty=/etc/recasaos/public-file.verifier
ConditionPathIsSymbolicLink=!/etc/recasaos/public-file.verifier
# MemorySwapMax is effective only on the unified hierarchy. Refuse to start or
# bind the public listener unless the host exposes the exact cgroup-v2 memory
# and pids controller files in the service's parent slice. The hierarchy root
# need not expose limit files even when delegated child cgroups do.
ConditionPathExists=/sys/fs/cgroup/cgroup.controllers
ConditionPathExists=/sys/fs/cgroup/system.slice/memory.max
ConditionPathExists=/sys/fs/cgroup/system.slice/memory.swap.max
ConditionPathExists=/sys/fs/cgroup/system.slice/pids.max
StartLimitIntervalSec=2min
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=recasaos-public
Group=recasaos-public
SupplementaryGroups=
UMask=0077

# The service executable is a statically linked binary inside this minimal
# root. The host share is the only application data exposed inside the jail.
RootDirectory=/usr/lib/recasaos-public-files/rootfs
WorkingDirectory=/
MountAPIVFS=yes
# Keep submounts visible so the portal's mount-ID and RESOLVE_NO_XDEV checks
# reject them. A non-recursive bind could expose files hidden below a host
# mountpoint as ordinary same-mount content inside the service.
BindReadOnlyPaths=/srv/recasaos-public:/srv/public:rbind
# systemd 247 exports NOTIFY_SOCKET but does not automatically bind the socket
# into RootDirectory=. systemd 248 and newer add the equivalent read-only bind;
# keep it explicit so readiness remains fail-closed on the supported floor. The
# tmpfiles payload pre-creates its root-owned target parent and placeholder.
BindReadOnlyPaths=/run/systemd/notify:/run/systemd/notify:norbind
# Expose only this unit's three effective cgroup-v2 limit files at fixed paths
# inside the jail. The process validates each mount's cgroup source, identity,
# read-only flag, and exact value before it loads the public credential.
BindReadOnlyPaths=/sys/fs/cgroup/system.slice/recasaos-public-files.service/memory.max:/run/recasaos-cgroup/memory.max:norbind
BindReadOnlyPaths=/sys/fs/cgroup/system.slice/recasaos-public-files.service/memory.swap.max:/run/recasaos-cgroup/memory.swap.max:norbind
BindReadOnlyPaths=/sys/fs/cgroup/system.slice/recasaos-public-files.service/pids.max:/run/recasaos-cgroup/pids.max:norbind
LoadCredential=recasaos-public-file-verifier:/etc/recasaos/public-file.verifier

# systemd 247 supports $CREDENTIALS_DIRECTORY expansion in ExecStart. The %d
# credential-directory specifier is newer (systemd 251) and is intentionally
# not used so this unit remains valid on the declared minimum version.
ExecStart=/usr/bin/recasaos-public-files serve --activation-name=public-files --listen=127.0.0.1:39777 --root=/srv/public --verifier-file=${CREDENTIALS_DIRECTORY}/recasaos-public-file-verifier

# The AF_INET listener is created by the socket unit in the host network
# namespace. This process may accept that inherited descriptor but cannot open
# a new IP socket or reach host-loopback management services.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

PrivateDevices=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# Access-control paths are host-relative by default even with RootDirectory=.
# The + prefix is therefore required to apply these controls inside the jail.
# /sys is mandatory and must fail startup if it cannot be masked. An already
# absent jail /dev/shm is also safe, so only that path retains the - prefix.
InaccessiblePaths=+/sys -+/dev/shm
ReadOnlyPaths=+/tmp +/var/tmp

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RemoveIPC=yes

# Keep openat2 available: the portal's descriptor-relative traversal depends
# on it. In particular, do not add DynamicUser= or RestrictSUIDSGID= here.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @keyring @module @mount @obsolete @privileged @raw-io @reboot @swap clone3 memfd_create
SystemCallErrorNumber=EPERM

LimitCORE=0
LimitNOFILE=512
# One coordinator generation can retain eight active plus three previously
# quarantined workers before admission closes. TasksMax and MemoryMax are the
# final unit-wide bounds, including any unkillable remnants from an older
# restart generation. Each child has a finite RLIMIT_AS covering its
# post-runtime baseline plus 256MiB and GOMAXPROCS=1, while GOMEMLIMIT=24MiB
# remains only a soft runtime budget.
TasksMax=256
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
TimeoutStartSec=30s
TimeoutStopSec=10s
KillMode=control-group
Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=recasaos-public-files
